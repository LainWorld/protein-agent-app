# Copy this file to backend/.env and edit locally in VS Code.
# Never put API keys in the frontend, screenshots, chat, or source control.
# Runtime and manual probe both use these server-only settings. Restart after editing.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# Each mode is independent. Check your free allocation before submitting a real fold.
ESMFOLD2_MODE=mock
PROTENIX_MODE=mock
MOCK_DELAY_SECONDS=3
JOB_TIMEOUT_SECONDS=30
# Select openprotein for the full ESMFold2 model or biohub for the Biohub Fast route.
# OpenProtein Real: use your platform credentials and allow JOB_TIMEOUT_SECONDS=900.
ESMFOLD2_PROVIDER=biohub
OPENPROTEIN_USERNAME=
OPENPROTEIN_PASSWORD=
# Biohub ESMFold2 Real. The Fast model ID and HTTPS origin must match these values.
# Generate a key at https://biohub.ai/developer-console/api-keys. Check Credits and Rate Limits.
# For a real fold, use ESMFOLD2_MODE=real and allow e.g. JOB_TIMEOUT_SECONDS=120.
ESMFOLD2_API_URL=https://biohub.ai
ESMFOLD2_MODEL=esmfold2-fast-2026-05
ESMFOLD2_API_KEY=
# Protenix Real runs on the backend host. Use the isolated official 2.0.0 CLI.
# Set an absolute executable path or put protenix on PATH. Allow e.g. JOB_TIMEOUT_SECONDS=1800.
PROTENIX_EXECUTABLE=
PROTENIX_MODEL=protenix_mini_default_v0.5.0
# Contains checkpoint/ and common/. An empty value uses the official default (home directory).
PROTENIX_ROOT_DIR=
